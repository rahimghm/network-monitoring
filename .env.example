POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=monitoring_dev_password

# Backend database connection inside Docker Compose
DB_HOST=db
DB_PORT=5432
DB_NAME=monitoring
DB_USER=monitoring
DB_PASSWORD=monitoring_dev_password

JWT_SECRET=change-this-development-secret
POLL_INTERVAL_SECONDS=20
SNMP_TIMEOUT=3
SNMP_RETRIES=1
HOSTNAME_CACHE_TTL_SECONDS=60

# External unicast DNS server. Keep this outside Docker Compose.
DNS_ENABLED=true
DNS_SERVER=192.168.56.20
DNS_PORT=53
DNS_TIMEOUT=3
DNS_DOMAIN=lab.example
